###  https://portal.mardi4nfdi.de/entity/Q6674126
<https://portal.mardi4nfdi.de/entity/Q6674126> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>A</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>n</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mn>1</mn><mo stretchy=\"false\">−</mo><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>A</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo stretchy=\"false\">+</mo><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msub></mrow></mrow></mfrac></mrow></mstyle></mrow><mo stretchy=\"false\">≥</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></mfrac></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "Allee effect"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P104> <https://en.wikipedia.org/wiki/Allee_effect> ;
                                               <https://portal.mardi4nfdi.de/entity/P12> "Q2301505"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "The Allee effect is used to model the infection rate as a function of population density, where it represents a lower transmission probability in less densely populated regions. We adopt the effect and bound it from below by 1⁄3. This ensures that the effect is at most three times lower in sparsely populated areas than in regions with high population density. To enforce the lower bound, we apply a shift n₀ in the Allee term. We choose n₀ = ³⁄₂·A."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://portal.mardi4nfdi.de/entity/P356> <http://commons.wikimedia.org/wiki/Special:FilePath/A%20graph%20showing%20the%20difference%20between%20strong%20and%20weak%20Allee%20effects.svg> ;
                                               <https://portal.mardi4nfdi.de/entity/P558> <https://portal.mardi4nfdi.de/entity/Q6775530> ;
                                               <https://schema.org/description> "effect to model the infection rate as a function of population density"@en .

