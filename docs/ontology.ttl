><mrow data-mjx-texclass=\"ORD\"><mi>l</mi></mrow></msub><mo stretchy=\"false\">−</mo><mi>W</mi><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mi>l</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></mfrac></mrow><mo stretchy=\"false\">+</mo><mi>W</mi><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mi>l</mi></mrow></msub></mtd></mtr><mtr><mtd class=\"mwe-math-columnalign-l\"><msub><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub></mtd><mtd class=\"mwe-math-columnalign-l\"><mspace width=\"1em\"></mspace><mrow data-mjx-texclass=\"ORD\"><mtext>if</mtext></mrow><mspace width=\"1em\"></mspace><mi>S</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>l</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">≥</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>F</mi><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>l</mi></mrow></msub><mo stretchy=\"false\">−</mo><mi>W</mi><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mi>l</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></mfrac></mrow><mo stretchy=\"false\">+</mo><mi>W</mi><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mi>l</mi></mrow></msub></mtd></mtr></mtable><mo fence=\"true\" stretchy=\"true\" symmetric=\"true\" data-mjx-texclass=\"CLOSE\"></mo></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "actual plant water use rate in soil layer equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation determines the actual plant water use rate from the potential plant water use rate considering the soil moisture. When soil water content falls below a threshold fraction of plant-available water, the use rate declines exponentially. Above this threshold, potential uptake is fully realized. The formulation captures the non-linear response of root water absorption to soil moisture availability."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "determines actual plant water use rate in specific soil layer"@en .

