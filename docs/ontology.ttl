###  https://portal.mardi4nfdi.de/entity/Q6821362
<https://portal.mardi4nfdi.de/entity/Q6821362> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>C</mi><mi>H</mi><mi>T</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>M</mi><mi>X</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>F</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>C</mi><mi>H</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>H</mi><mi>M</mi><msub><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mrow data-mjx-texclass=\"ORD\"><msqrt><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>U</mi><msub><mi>F</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mrow></msqrt></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "crop height equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes crop height as a function of phenological development. Height increases with accumulated thermal progress and approaches a crop-specific maximum value as the crop matures. The formulation assumes a monotonic relationship between development stage and plant height, representing structural growth in a simplified manner. It does not explicitly model biomass allocation or mechanical growth processes. The equation provides a deterministic estimate of canopy height at discrete time steps for use in crop growth and environmental models."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "computes height of crop"@en .

