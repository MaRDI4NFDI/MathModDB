                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "integer number identifying a specific day"@en .


###  https://portal.mardi4nfdi.de/entity/Q6821290
<https://portal.mardi4nfdi.de/entity/Q6821290> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
                                               rdfs:label "daily change in leaf area index"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This quantity represents the daily change in leaf area index before the onset of leaf decline. The quantity controls the dynamic evolution of canopy size over time."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q6534271> ;
