###  https://portal.mardi4nfdi.de/entity/Q6822105
<https://portal.mardi4nfdi.de/entity/Q6822105> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mi>X</mi><mi>G</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mi>X</mi><mi>N</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mi>X</mi><mi>R</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mi>X</mi><mi>W</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>i</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mi>X</mi><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mo>min</mo><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mn>1.0</mn><mo>,</mo><mi>F</mi><mi>X</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo>,</mo><mi>F</mi><mi>X</mi><msub><mi>N</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">)</mo><mi>F</mi><mi>X</mi><msub><mi>G</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "nitrogen fixation fraction equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes the fraction of plant nitrogen demand that can be met by biological nitrogen fixation. It combines multiple limiting factors representing plant phenology, soil water status, and soil nitrate availability. The fixation fraction is constrained by the most limiting environmental factor and modulated by plant growth stage, representing physiological and environmental controls on symbiotic nitrogen fixation."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "combined environmental fixation limitation"@en .

