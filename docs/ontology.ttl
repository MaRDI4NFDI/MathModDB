<https://portal.mardi4nfdi.de/wiki/> rdf:type owl:Ontology ;
                                      owl:versionIRI <https://portal.mardi4nfdi.de/wiki//2.0.0> ;
                                      <http://purl.org/dc/terms/abstract> "MathModDB is a database of mathematical models developed by the Mathematical Research Data Initiative (MaRDI). It defines a data model with classes (Mathematical Model, Mathematical Formulation, Academic Discipline, Research Problem, Quantity [Kind], Computational Task, Publication), object properties/relations, data properties and annotation properties as an ontology. This ontology is populated with individuals/data from various fields of applied mathematics, making it a knowledge graph. This is a snapshot of MathModDB. The current version is maintained on the MaRDI Portal."@en ;
                                      <http://purl.org/dc/terms/bibliographicCitation> "Shehu, A., Schembera, B., Schmidt, B., Biedinger, C., Fiedler, J., Reidelbach, M., Koprucki, T. (2025): MathModDB Ontology and Knowledge Graph for Mathematical Models"@en ;
                                      <http://purl.org/dc/terms/creator> "Aurela Shehu (https://orcid.org/0000-0002-1994-0612), Weierstrass Institute Berlin for Applied Analysis and Stochastics (https://ror.org/00h1x4t21, https://isni.org/isni/000000010066936X)"@en ,
                                                                         "Björn Schembera (https://orcid.org/0000-0003-2860-6621), Universität Stuttgart (https://ror.org/04vnq7t77, https://isni.org/isni/0000000419369713)"@en ,
                                                                         "Burkhard Schmidt (https://orcid.org/0000-0002-9658-499X), Weierstrass Institute Berlin for Applied Analysis and Stochastics (https://ror.org/00h1x4t21, https://isni.org/isni/000000010066936X)"@en ,
                                                                         "Christine Biedinger (https://orcid.org/0009-0002-5082-8386), Fraunhofer Institute for Industrial Mathematics ITWM (https://ror.org/019hjw009)"@en ,
                                                                         "Jochen Fiedler (https://orcid.org/0000-0002-9176-780X), Fraunhofer Institute for Industrial Mathematics ITWM (https://ror.org/019hjw009)"@en ,
                                                                         "Marco Reidelbach (https://orcid.org/0000-0002-1919-1834), Zuse Institute Berlin (https://ror.org/02eva5865, https://isni.org/isni/000000011010926X)"@en ,
                                                                         "Thomas Koprucki (https://orcid.org/0000-0001-6235-9412), Weierstrass Institute Berlin for Applied Analysis and Stochastics (https://ror.org/00h1x4t21, https://isni.org/isni/000000010066936X)"@en ;
                                      <http://purl.org/dc/terms/issued> "2026-07-23"^^xsd:dateTime ;
                                      <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                      <http://purl.org/dc/terms/modified> "2026-07-23"^^xsd:dateTime ;
                                      <http://purl.org/dc/terms/publisher> "Mathematical Research Data Initiative (MaRDI, https://www.mardi4nfdi.de)"@en ;
                                      <http://purl.org/dc/terms/title> "MathModDB Knowledge Graph of Mathematical Models"@en ;
                                      rdfs:comment "This is the MathModDB Ontology for documenting mathematical models."@en ;
                                      rdfs:label "MathModDB Ontology"@en ;
                                      rdfs:seeAlso <https://doi.org/10.1007/978-3-031-65990-4_14> ,
                                                   <https://doi.org/10.1007/978-3-031-81974-2_8> ,
                                                   <https://doi.org/10.52825/cordi.v1i.255> ;
                                      owl:versionInfo "2.0.0" .

