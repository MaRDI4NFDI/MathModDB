                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>d</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow></mrow></mfrac></mrow><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow></mrow></mfrac></mrow><mo stretchy=\"false\">)</mo></mstyle></mrow></math>"@en ;
