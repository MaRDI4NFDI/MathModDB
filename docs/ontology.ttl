                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><mi>W</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><mi>W</mi><mi>T</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><mi>Δ</mi><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><munderover><mo movablelimits=\"false\" stretchy=\"false\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>l</mi><mo stretchy=\"false\">=</mo><mn>1</mn></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mi>M</mi></mrow></munderover><msub><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "root biomass distribution equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation distributes the total daily increase in root biomass among soil layers in proportion to plant water use in each layer. The formulation assumes that layers contributing more to water uptake also receive a larger share of new root growth. Normalization by total water use ensures conservation of total root biomass increment across layers. The approach yields realistic vertical root distributions under non-limiting conditions and dynamically adjusts allocation when soil water or root stress factors reduce water uptake."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "allocates root biomass growth according to water use"@en .

