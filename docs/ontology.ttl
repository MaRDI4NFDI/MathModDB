###  https://portal.mardi4nfdi.de/entity/Q6824223
<https://portal.mardi4nfdi.de/entity/Q6824223> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>W</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>i</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>l</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><mi>W</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><mi>R</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo stretchy=\"false\">−</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></mrow></msub><mo stretchy=\"false\">+</mo><mi>Δ</mi><mi>R</mi><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "root weight in soil layer accumulation equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation updates the accumulated root weight in soil layer by adding the daily root weight in soil layer increment to its previous value. It represents the temporal integration of daily root weight production in soil layer over the growing season. The formulation assumes that root weight accumulation is additive and does not impose additional physiological constraints beyond those governing daily production. The equation is applied at each simulation time step to maintain the root weight state variable. It provides the accumulated root weight in soil layer used in subsequent processes, e.g. plant phosphorus uptake."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "accumulates daily root weight in soil layer"@en .

