###  https://portal.mardi4nfdi.de/entity/Q6821386
<https://portal.mardi4nfdi.de/entity/Q6821386> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>D</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>Z</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">≤</mo><mi>R</mi><msub><mi>Z</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "rooting depth constraint"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This constraint limits simulated crop rooting depth to the depth of the soil profile. It prevents roots from extending beyond physically available soil layers. The constraint reflects soil-imposed limitations on root system expansion. It is applied after computing potential rooting depth from phenological development."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "limits rooting depth to soil profile depth"@en .

