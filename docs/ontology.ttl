###  https://portal.mardi4nfdi.de/entity/Q6821275
<https://portal.mardi4nfdi.de/entity/Q6821275> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>I</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>P</mi><mi>H</mi><mi>U</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><munderover><mo movablelimits=\"false\" stretchy=\"false\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>K</mi><mo stretchy=\"false\">=</mo><mn>1</mn></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></munderover><mi>H</mi><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mi>H</mi><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub></mrow></mrow></mfrac></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "heat unit index equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes the heat unit index as the ratio of accumulated heat units to the potential heat units required for crop maturity. The index ranges from zero at planting to one at physiological maturity. It provides a normalized, dimensionless measure of development stage. Many other models use this index to regulate growth, partitioning, and senescence processes."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "normalizes accumulated heat units to maturity"@en .

