###  https://portal.mardi4nfdi.de/entity/Q6821385
<https://portal.mardi4nfdi.de/entity/Q6821385> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>I</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>D</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>D</mi><mi>M</mi><mi>X</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mn>2.5</mn><mi>R</mi><mi>D</mi><mi>M</mi><msub><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "rooting depth equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes crop rooting depth as a linear function of phenological development represented by the heat unit index. Root depth increases proportionally with heat unit accumulation and approaches a crop-specific maximum under ideal soil conditions. A scaling constant ensures that maximum rooting depth is attained early in the growing season, before physiological maturity. The computed rooting depth is constrained by the soil profile depth, preventing roots from extending beyond the available root zone. The equation provides a simplified representation of root system expansion."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "computes crop rooting depth from heat unit index"@en .

