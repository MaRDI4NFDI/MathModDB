                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Y</mi><mi>L</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>H</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>A</mi><mi>G</mi></mrow></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "crop economic yield equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes crop economic yield as the product of harvest index and above-ground biomass. It assumes that yield is proportional to vegetative biomass production. The formulation represents a harvest index–based yield estimation approach commonly used in crop models. It provides a simple and robust link between biomass growth and harvestable yield."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "computes economic yield from harvest index"@en .

