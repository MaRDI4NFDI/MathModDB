                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>i</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>W</mi><mi>F</mi><msub><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>F</mi><mi>X</mi><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mi>U</mi><mi>N</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "daily nitrogen fixation equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation estimates the daily amount of biologically fixed nitrogen in legume crops as a fraction of plant nitrogen demand. The daily fixation is computed by multiplying the plant nitrogen demand rate by a daily fixation fraction. The equation represents the core nitrogen fixation calculation and links plant nitrogen status, environmental conditions, and phenological development to the actual daily nitrogen acquired from atmospheric sources."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "daily nitrogen fixation from plant demand"@en .

