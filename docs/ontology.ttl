###  https://portal.mardi4nfdi.de/entity/Q6821307
<https://portal.mardi4nfdi.de/entity/Q6821307> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mi>p</mi></mrow></msub></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mi>p</mi></mrow></msub></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>p</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>p</mi><mo>,</mo><mi>i</mi><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy=\"false\">+</mo><mi>Δ</mi><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>p</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "potential biomass accumulation equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation updates the accumulated potential crop biomass by adding the daily potential biomass increment to its previous value. It represents the temporal integration of daily biomass production over the growing season. The formulation assumes that biomass accumulation is additive and does not impose additional physiological constraints beyond those governing daily production. The equation is applied at each simulation time step to maintain the biomass state variable. It provides the accumulated potential biomass used in subsequent allocation and yield formation processes."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "accumulates daily potential crop biomass"@en .

