                                               <https://portal.mardi4nfdi.de/entity/P1690> <https://www.openfoam.com/documentation/guides/v1912/doc/guide-applications-solvers-incompressible-simpleFoam.html> ,
                                                                                           <https://www.openfoam.com/documentation/guides/v1912/doc/verification-validation-rotating-cylinders-2d.html> ;
                                               <https://portal.mardi4nfdi.de/entity/P286> <https://portal.mardi4nfdi.de/entity/Q6830687> ;
                                               <https://portal.mardi4nfdi.de/entity/P356> <http://commons.wikimedia.org/wiki/Special:FilePath/CouetteTaylorSystem.png> ;
                                               <https://portal.mardi4nfdi.de/entity/P558> <https://portal.mardi4nfdi.de/entity/Q1512328> ,
                                                                                          <https://portal.mardi4nfdi.de/entity/Q564419> ;
                                               <https://schema.org/description> "viscous fluid confined in the gap between two rotating cylinders of different radii and angular velocities"@en .


