###  https://portal.mardi4nfdi.de/entity/Q6775832
<https://portal.mardi4nfdi.de/entity/Q6775832> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
                                               rdfs:label "nonlinear parameter estimation (Hill adsorption model)"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This task performs nonlinear parameter estimation using equilibrium adsorption data applied to the Hill adsorption model. It determines the Hill adsorption constant, the maximum adsorption capacity, and the cooperativity exponent by directly fitting the nonlinear Hill isotherm to solute concentration and adsorbed-amount measurements. Nonlinear regression avoids structural distortions introduced by linearized forms and ensures accurate estimation of parameters across cooperative and non-cooperative regimes. The resulting parameters quantify adsorption affinity, surface saturation behavior, and cooperative interactions among adsorbed species. This approach is commonly used in environmental and materials science to analyze sigmoidal adsorption equilibria."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q6534272> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://portal.mardi4nfdi.de/entity/P1560> <https://portal.mardi4nfdi.de/entity/Q6775715> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6775716> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6775831> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6775846> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6775847> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6775848> ;
                                               <https://portal.mardi4nfdi.de/entity/P558> <https://portal.mardi4nfdi.de/entity/Q3116516> ;
                                               <https://schema.org/description> "nonlinear estimation of Hill adsorption model parameters"@en .


###  https://portal.mardi4nfdi.de/entity/Q6775833
<https://portal.mardi4nfdi.de/entity/Q6775833> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>n</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>n</mi><mo stretchy=\"false\">=</mo><mn>1</mn></mstyle></mrow></math>"@en ;
