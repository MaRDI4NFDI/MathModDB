                                               rdfs:label "Lindblad equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P12> "Q4476520"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "Markovian quantum master equation for the evolution of quantum mechanical density matrices (pure or mixed states).  It generalizes the Schrödinger equation to open quantum systems; that is, systems in contacts with their surroundings. The resulting dynamics is no longer unitary, but still satisfies the property of being trace-preserving and completely positive for any initial condition."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://portal.mardi4nfdi.de/entity/P1560> <https://portal.mardi4nfdi.de/entity/Q6674309> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6674409> ;
                                               <https://portal.mardi4nfdi.de/entity/P1690> <https://en.wikipedia.org/wiki/Lindbladian> ;
                                               <https://portal.mardi4nfdi.de/entity/P558> <https://portal.mardi4nfdi.de/entity/Q1054395> ;
                                               <https://schema.org/description> "describes open system quantum dynamics including dissipation and/or decoherence"@en .

