                                                                                           <https://portal.mardi4nfdi.de/entity/Q6822037> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6822038> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6822039> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6822040> ;
                                               <https://schema.org/description> "scaling nitrogen uptake to match crop demand"@en .


###  https://portal.mardi4nfdi.de/entity/Q6822042
<https://portal.mardi4nfdi.de/entity/Q6822042> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q68663> ;
                                               rdfs:label "plant nitrogen uptake and demand model"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This model simulates crop nitrogen use using a supply–demand framework. Crop nitrogen demand is computed from accumulated biomass and an ideal nitrogen concentration that varies with crop development. Soil nitrogen supply is estimated from nitrate transport to roots by mass flow, distributed across soil layers according to plant water uptake. Actual nitrogen uptake is obtained by adjusting soil nitrogen supply to match crop demand while respecting soil nitrate availability. The model links crop growth, soil water use, and nitrogen dynamics in a mechanistic way."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q6534270> ;
                                               <https://portal.mardi4nfdi.de/entity/P147> <https://portal.mardi4nfdi.de/entity/Q6822038> ,
                                                                                          <https://portal.mardi4nfdi.de/entity/Q6822039> ,
                                                                                          <https://portal.mardi4nfdi.de/entity/Q6822040> ,
                                                                                          <https://portal.mardi4nfdi.de/entity/Q6822041> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://portal.mardi4nfdi.de/entity/P1560> <https://portal.mardi4nfdi.de/entity/Q6821278> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6821601> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6822032> ,
                                                                                           <https://portal.mardi4nfdi.de/entity/Q6822033> ,
