###  https://portal.mardi4nfdi.de/entity/Q6821313
<https://portal.mardi4nfdi.de/entity/Q6821313> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>B</mi><mi>E</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>P</mi><mi>A</mi><mi>R</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>H</mi><mi>R</mi><mi>L</mi><mi>T</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mi>p</mi></mrow></msub></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>p</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><mn>0.001</mn><mi>B</mi><msub><mi>E</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mi>P</mi><mi>A</mi><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">+</mo><mi>Δ</mi><mi>H</mi><mi>L</mi><mi>R</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup></mstyle></mrow></math>"@en ;
                                               rdfs:label "potential biomass growth equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation estimates the daily potential increase in crop biomass using a radiation use efficiency approach. It follows the formulation proposed by Monteith, relating intercepted photosynthetically active radiation to dry matter production. Biomass accumulation is adjusted by a factor accounting for daylength and its daily change. The conversion efficiency parameter represents the crop-specific ability to transform radiant energy into biomass. The equation assumes optimal growing conditions without water or nutrient stress."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://portal.mardi4nfdi.de/entity/P286> <https://portal.mardi4nfdi.de/entity/Q6821309> ;
                                               <https://schema.org/description> "estimates daily potential crop biomass increase following Monteith"@en .

