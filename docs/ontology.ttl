###  https://portal.mardi4nfdi.de/entity/Q6821423
<https://portal.mardi4nfdi.de/entity/Q6821423> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>F</mi><mi>H</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>I</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>F</mi><msub><mi>H</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>6.50</mn><mo stretchy=\"false\">−</mo><mn>10.0</mn><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mrow></mrow></msup></mrow></mrow></mfrac></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "harvest index heat unit factor equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes a heat unit factor that controls the rate of harvest index development. The factor increases non-linearly with phenological development represented by the heat unit index. Parameter values are chosen so that most crop yield is produced during the second half of the growing season. The formulation reflects observed reproductive development patterns in grain crops."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "computes phenological scaling factor for harvest index"@en .

