                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>x</mi></mrow></mrow></msub></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>x</mi><mo>,</mo><mi>K</mi></mrow></mrow></msub><mo stretchy=\"false\">+</mo><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>n</mi><mo>,</mo><mi>K</mi></mrow></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></mfrac></mrow><mo stretchy=\"false\">−</mo><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>b</mi><mo>,</mo><mi>j</mi></mrow></mrow></msub></mstyle></mrow></math>"@en ;
                                               rdfs:label "heat unit accumulation equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation calculates the daily heat units contributing to crop development based on daily maximum and minimum air temperatures. Only temperatures exceeding a crop-specific base temperature contribute to development. Negative values are truncated to zero to prevent development under unsuitable thermal conditions. The resulting heat units are accumulated over time to drive phenological progress."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "effective thermal time per day"@en .

