###  https://portal.mardi4nfdi.de/entity/Q6821302
<https://portal.mardi4nfdi.de/entity/Q6821302> rdf:type owl:NamedIndividual ,
                                                        <https://portal.mardi4nfdi.de/entity/Q96183> ;
                                               <https://portal.mardi4nfdi.de/entity/P983> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>R</mi><mi>L</mi><mi>T</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>L</mi><mi>A</mi><mi>T</mi></mstyle></mrow></math>"@en ,
                                                                                          "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>S</mi><mi>D</mi></mstyle></mrow></math>"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P989> "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>R</mi><mi>L</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mn>7.64</mn><msup><mi>cos</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></mrow></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">−</mo><mi>sin</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mn>360</mn></mrow></mfrac></mrow><mi>L</mi><mi>A</mi><mi>T</mi><mo stretchy=\"false\">)</mo><mi>sin</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mi>S</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">−</mo><mn>0.044</mn></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>cos</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mn>360</mn></mrow></mfrac></mrow><mi>L</mi><mi>A</mi><mi>T</mi><mo stretchy=\"false\">)</mo><mi>cos</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mi>S</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">)</mo></mrow></mrow></mfrac></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mstyle></mrow></math>"@en ;
                                               rdfs:label "daylength calculation equation"@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1459> "This equation computes the length of daylight as a function of geographic latitude and the Sun’s declination angle. It is based on astronomical relationships describing Earth–Sun geometry over the annual cycle. Daylength varies seasonally and with latitude, influencing available solar radiation and crop growth potential. The equation provides a deterministic estimate of photoperiod for each simulation day. Daylength is later used to modulate potential biomass production."@en ;
                                               <https://portal.mardi4nfdi.de/entity/P1460> <https://portal.mardi4nfdi.de/entity/Q5981696> ;
                                               <https://portal.mardi4nfdi.de/entity/P1495> <https://portal.mardi4nfdi.de/entity/Q6534265> ;
                                               <https://schema.org/description> "computes daylength from latitude and solar declination"@en .

