    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775394">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">light particle eigen energy</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Note that in quantum-classical dynamics the parametric dependence of the light particle(s) eigen energies can be interpreted as adiabatic potential energy curves|surfaces governing the heavy particle(s) positions. In one dimension, they may feature avoided or true crossings, in two (or more) dimensions they may display conical intersections.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">adiabatic eigen energy of the light particle(s) dynamics in quantum-classical models</schema:description>
    </owl:NamedIndividual>



