        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">molecules of Signal (A) are continuously produced and converted into molecules of morphogen (B)</schema:description>
    </owl:NamedIndividual>
