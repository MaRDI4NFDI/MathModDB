        <rdfs:label xml:lang="en">quantum-classical mass separation</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Often the square root (or sometimes the fourth root) of the light-to-heavy mass ratio are used as smallness parameters in defining an asymptotic limit for quantum-classical dynamics</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">assuming separation of mass scales is the basis of all quantum-classical dynamics models</schema:description>
    </owl:NamedIndividual>
