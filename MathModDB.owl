        <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q4117184"/>
        <schema:description xml:lang="en">vector field representing the flux density of the hydrostatic force within the bulk of a fluid</schema:description>
    </owl:NamedIndividual>



