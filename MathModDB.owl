    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6534306">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">quantum eigen energy</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Eigenenergy are obtained as eigenvalues of the Quantum Hamiltonian Operator by solving the time-independent Schrödinger equation.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
