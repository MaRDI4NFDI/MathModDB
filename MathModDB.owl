    <!-- https://portal.mardi4nfdi.de/entity/Q6820970 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820970">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Kiselev isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Kiselev isotherm model describes adsorption occurring in a localized monomolecular layer, where adsorbate molecules may form surface complexes with one another. Unlike the Langmuir model, Kiselev explicitly includes a complex-formation parameter that accounts for associations between adsorbed molecules at neighboring sites. This allows the model to represent cooperative or associative adsorption behavior on heterogeneous or interacting surfaces. It is used primarily to interpret adsorption on solids where pairwise interactions or dimer formation occurs. Applications include surface chemistry, catalysis, and environmental adsorption processes such as chemical wastewater treatment.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820971"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820972"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820976"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820992"/>
        <schema:description xml:lang="en">adsorption model for localized monolayer with complex formation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820971 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820971">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Kiselev model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Kiselev equilibrium constant and the complex formation constant. The nonlinear Kiselev equation is fitted directly to coverage and concentration values to capture the formation of complexes between adsorbed molecules. The results quantify adsorption affinity and the strength of lateral associative interactions. This method avoids potential distortions caused by linearization.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820973"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820974"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820976"/>
        <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820972"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820992"/>
        <schema:description xml:lang="en">nonlinear estimation of Kiselev model parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820972 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820972">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">linear parameter estimation (Kiselev model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task estimates the Kiselev equilibrium constant and the complex formation constant using the linearized form of the Kiselev isotherm. Experimental equilibrium coverage and concentration data are transformed and analyzed using linear regression. Although computationally simple, the approach may introduce bias due to data transformation. The estimated parameters describe adsorption affinity and the extent of complex formation among adsorbed species.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820973"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820974"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820975"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820992"/>
        <schema:description xml:lang="en">nonlinear estimation of Kiselev model parameters</schema:description>
    </owl:NamedIndividual>



