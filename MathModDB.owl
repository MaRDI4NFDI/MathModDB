        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684675"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684677"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684678"/>
        <schema:description xml:lang="en">measurement (or simulation) of interactions between electromagnetic waves and matter</schema:description>
    </owl:NamedIndividual>



