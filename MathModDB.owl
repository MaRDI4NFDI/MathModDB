    <!-- https://portal.mardi4nfdi.de/entity/Q6684650 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6684650">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">free flow coupled to porous media flow</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Systems where free flow interacts with permeable media are important in many areas. Examples include soil water evaporation in environmental science, exchange between blood vessels in medicine or water management in fuel cells. To understand these processes, it is necessary to capture the interaction between the two flow regions. In this specific case we consider a stationary, single-phase flow where creeping Stokes flow describes the free-flow region and Darcy’s law governs the porous medium.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6675408"/>
        <mathmoddb:P1640 rdf:resource="https://portal.mardi4nfdi.de/wiki/File:FreeFlowPorousDomain.png"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6376356"/>
        <schema:description xml:lang="en">coupled systems of free flow of an incompressible fluid adjacent to permeable media</schema:description>
    </owl:NamedIndividual>



