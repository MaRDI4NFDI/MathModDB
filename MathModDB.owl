    <!-- https://portal.mardi4nfdi.de/entity/Q6822199 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822199">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">gas separation (adsorption)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Gas separation using adsorption is a process in which specific gas components are selectively adsorbed onto solid surfaces. The equilibrium between the adsorbed phase and the gas phase can often be described by the Langmuir adsorption isotherm. Research includes studying adsorbent materials, optimizing operating conditions, and evaluating separation efficiency and selectivity. This process is applied in industrial contexts such as carbon dioxide capture, air purification, and hydrogen recovery. Understanding adsorption thermodynamics and kinetics is essential for designing efficient gas separation systems.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
        <schema:description xml:lang="en">selective adsorption of gas components onto solid surfaces for separation</schema:description>
    </owl:NamedIndividual>



