    <!-- https://portal.mardi4nfdi.de/entity/Q6821326 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821326">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Dubinin–Astakhov model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using equilibrium adsorption data to determine the theoretical Dubinin–Astakhov isotherm saturation capacitythe, Dubinin–Astakhov isotherm constant, and the Dubinin–Astakhov heterogeneity exponent. The nonlinear Dubinin–Astakhov equation is fitted directly to equilibrium adsorption values determined by experimental adsorption measurements, using the Polanyi potential to capture the effective adsorption work. Because the Dubinin–Astakhov model is temperature-dependent, it can consolidate multi-temperature data into a single characteristic curve that describes micropore filling behavior.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821320"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821321"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821324"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821325"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821130"/>
        <schema:description xml:lang="en">nonlinear estimation of Dubinin–Astakhov isotherm parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821327 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821327">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Dubinin–Astakhov isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Dubinin–Astakhov isotherm model is an empirical adsorption model developed to describe adsorption in microporous solids using a pore-filling mechanism. It generalizes the Dubinin–Radushkevich model by introducing a (flexible) exponent that allows flexible representation of surface heterogeneity and adsorption energy distributions. While originally proposed for heterogeneous microporous systems, experimental evidence shows that it can also successfully describe adsorption in nearly homogeneous microporous materials. The model expresses adsorption as a function of adsorption potential rather than concentration alone, making it explicitly temperature dependent. It is widely applied in adsorption studies of activated carbons, zeolites, and environmental adsorption processes.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821326"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821322"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821325"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821128"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5729941"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821141"/>
        <schema:description xml:lang="en">micropore filling adsorption model with variable heterogeneity</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821329 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821329">
