    <!-- https://portal.mardi4nfdi.de/entity/Q6820977 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820977">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Volmer isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Volmer isotherm model describes adsorption in a mobile monolayer, where adsorbed molecules can move freely across the surface but do not interact with each other. It applies an exponential correction term that accounts for the configurational entropy associated with mobile adsorbates. The model uses the fractional surface coverage and an affinity constant that depends on temperature. Unlike interaction-based models such as Fowler–Guggenheim or Hill–de Boer, the Volmer approach assumes no lateral interactions between adsorbates. It is used to characterize adsorption systems where mobility dominates surface behavior, including applications in surface chemistry and chemical wastewater treatment.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820978"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820980"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q4479187"/>
        <schema:description xml:lang="en">adsorption model accounting for mobile adsorbed molecules</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820978 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820978">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Volmer model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Volmer affinity constant. The nonlinear Volmer equation is fitted directly to fractional surface coverage and equilibrium concentration values, capturing the effect of adsorbate mobility on the adsorbent surface. The results quantify adsorption affinity while assuming no lateral interactions among adsorbed molecules. This approach avoids distortions caused by data linearization and is suitable for systems exhibiting mobile monolayer adsorption.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820979"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820980"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q4479187"/>
        <schema:description xml:lang="en">nonlinear estimation of Volmer affinity constant</schema:description>
    </owl:NamedIndividual>



