    <!-- https://portal.mardi4nfdi.de/entity/Q6821173 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821173">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Radke-Prausnitz isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Radke-Prausnitz isotherm is an empirical three-parameter adsorption model which is typically applied in adsorption systems when the concentration of the adsorbate is relatively low. Under certain conditions it reduces the Henry, Freundlich, or Langmuir isotherm model</mathmoddb:P1459>
