    <!-- https://portal.mardi4nfdi.de/entity/Q6673840 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6673840">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">external force density</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">In fluid mechanics, the force density is the negative gradient of pressure. It has the physical dimensions of force per unit volume. Force density is a vector field representing the flux density of the hydrostatic force within the bulk of a fluid.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
