        <owl:annotatedTarget xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;msub&gt;&lt;mi&gt;c&lt;/mi&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mi&gt;D&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
        <mathmoddb:P984 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775853"/>
    </owl:Axiom>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775842 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775842">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Emax model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation for the non-cooperative Emax dose–response model. It determines the maximal effect and the half-maximal effective concentration by directly fitting the nonlinear Emax equation to measured concentration–response data. Nonlinear regression avoids the biases associated with linearized transformations and provides accurate estimates of potency and maximal efficacy. The resulting parameters characterize the saturation behavior of the system and the sensitivity of the response to changing concentrations. This approach is widely used in pharmacology and toxicology to quantify drug action under non-cooperative conditions.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775841"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775851"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775852"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775853"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775854"/>
        <schema:description xml:lang="en">nonlinear estimation of Emax model parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775843 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775843">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Hill model (binding)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Hill model in binding is an empirical equilibrium model used to describe cooperative interactions between ligands and macromolecular binding sites. It represents fractional occupancy as a sigmoidal function of ligand concentration, controlled by the Hill coefficient, which quantifies positive or negative cooperativity. The model provides a phenomenological framework for allosteric or multi-site binding without requiring a detailed mechanistic interpretation of the molecular steps involved. When the Hill coefficient equals one, the model reduces to simple non-cooperative binding governed by mass-action behavior, though no distinct classical model emerges from this case. The Hill binding model is widely applied in biochemistry, molecular biology, and systems biology to analyze cooperative binding equilibria.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775845"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775844"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775862"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3116516"/>
        <schema:description xml:lang="en">empirical model describing cooperative ligand binding</schema:description>
    </owl:NamedIndividual>



