        <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Stokes_flow"/>
        <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q7618547"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q1515766"/>
        <schema:description xml:lang="en">describes a fluid flow with small advective inertial forces compared to viscous forces</schema:description>
    </owl:NamedIndividual>



