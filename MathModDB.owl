        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">uni uni reaction with reversible partial inhibition</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Uni Uni Reaction with reversible inhibition. The enzyme-inhibitor-substrate complex (EIS) can form product, the inhibition is thus partial.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
