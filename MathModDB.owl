    <!-- https://portal.mardi4nfdi.de/entity/Q6775642 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775642">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
        <rdfs:label xml:lang="en">microbiology</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q7193</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">Microbiology is the scientific study of microorganisms, including bacteria, viruses, fungi, and other microscopic life forms. It explores their structure, function, ecology, and roles in health, disease, and the environment. The discipline connects fundamental biology with applications in medicine, biotechnology, and industry.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775643"/>
        <mathmoddb:P356 rdf:resource="http://commons.wikimedia.org/wiki/Special:FilePath/Agar%20plate%20with%20colonies.jpg"/>
        <schema:description xml:lang="en">study of microscopic organisms</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775643 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775643">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">bacterial growth</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q762045</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">The bacterial growth problem examines how bacteria multiply and change over time under varying environmental and nutrient conditions. It explores factors such as temperature, nutrient availability, and competition that influence the rate and extent of bacterial population growth.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
