    <!-- https://portal.mardi4nfdi.de/entity/Q6821601 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821601">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">crop water usage model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model simulates the potential and actual water use of crops from the soil profile. It estimates plant evaporation as a function of potential evaporation and canopy development. Water uptake is distributed through the root zone according to an exponential depth function that can account for soil water deficit compensation. The model further reduces potential uptake when soil moisture becomes limiting. Together, these components provide a mechanistic representation of plant water use under varying soil and atmospheric conditions.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821596"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821598"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821599"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821600"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821355"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821588"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821593"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821594"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821597"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">simulates crop water uptake from soil profile</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821602 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821602">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of crop water use</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem addresses how crops extract water from the soil to meet atmospheric demand. Plant water use depends on canopy development, soil moisture availability, and the ability of plants to compensate for local water deficits. The problem links soil hydrology with plant physiological demand.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821601"/>
        <schema:description xml:lang="en">quantify plant water uptake from soil</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821603 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821603">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
        <rdfs:label xml:lang="en">agricultural hydrology</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q2883300</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">Agricultural hydrology examines the movement, availability, and use of water in agricultural landscapes. It integrates soil physics, plant physiology, and atmospheric processes to understand crop water demand and supply. Models of plant water uptake provide essential tools for evaluating irrigation needs, drought impacts, and water-use efficiency. The discipline supports sustainable water management in crop production systems.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821602"/>
        <schema:description xml:lang="en">study of water balance components intervening in agricultural water management, especially in irrigation and drainage</schema:description>
    </owl:NamedIndividual>



