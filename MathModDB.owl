        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775433"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775435"/>
        <mathmoddb:P1690 rdf:resource="https://qcmd.info"/>
        <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q65091550"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775315"/>
