    <!-- https://portal.mardi4nfdi.de/entity/Q6775815 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775815">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">linear parameter estimation (Elovich isotherm)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Elovich equilibrium constant and the Elovich maximum adsorption capacity by fitting the linearized form of the Elovich isotherm to measured values of adsorbed amount and equilibrium solution concentration. The linearization expresses the ratio of adsorbed amount to equilibrium concentration in logarithmic form, allowing the model parameters to be obtained from the slope and intercept of a straight-line plot. The resulting parameters describe the surface heterogeneity and the exponential energy distribution assumed by the empirical Elovich model.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775770"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775817"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775818"/>
        <schema:description xml:lang="en">linear estimation of Elovich adsorption parameters from equilibrium data</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775816 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775816">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Elovich isotherm)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Elovich equilibrium constant and the Elovich maximum adsorption capacity by fitting the original nonlinear Elovich isotherm directly to measured equilibrium concentration and adsorbed amount data. Nonlinear regression avoids the distortions introduced by logarithmic transformation and generally provides more accurate estimates of both parameters. The resulting parameter values characterize adsorption affinity and the heterogeneous, energy-dependent adsorption behavior represented by the empirical Elovich model.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775770"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775814"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775817"/>
        <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775815"/>
        <schema:description xml:lang="en">nonlinear estimation of Elovich adsorption parameters from equilibrium data</schema:description>
    </owl:NamedIndividual>



