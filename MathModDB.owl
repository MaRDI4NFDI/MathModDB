        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">fraction of binding sites occupied at equilibrium</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820955 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820955">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Temkin isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Temkin isotherm model is an empirical adsorption model that assumes the heat of adsorption decreases linearly with increasing surface coverage because of adsorbate–adsorbent interactions. Unlike Langmuir, it does not assume a constant adsorption energy but instead introduces a uniform distribution of binding energies up to a maximum value. This results in a logarithmic dependence between fractional coverage and solution concentration. The Temkin isotherm is commonly used to analyze adsorption processes where interactions between adsorbed molecules cannot be neglected. It is frequently applied in environmental chemistry and materials science, including studies related to chemical wastewater treatment.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820956"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820957"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820961"/>
        <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Langmuir_adsorption_model#Temkin_adsorption_isotherm"/>
        <mathmoddb:P1690 rdf:resource="https://ru.wikipedia.org/wiki/%D0%A2%D1%91%D0%BC%D0%BA%D0%B8%D0%BD,_%D0%9C%D0%B5%D0%BD%D0%B0%D1%81%D1%81%D0%B8%D0%B9_%D0%98%D1%81%D0%B0%D0%B0%D0%BA%D0%BE%D0%B2%D0%B8%D1%87"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821336"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821374"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821611"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821796"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822055"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820993"/>
        <schema:description xml:lang="en">empirical adsorption model with linearly decreasing adsorption energy</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820956 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820956">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Temkin isotherm model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data based on the Temkin isotherm model. It determines the Temkin equilibrium constant and the adsorption-energy variation by fitting the nonlinear Temkin equation directly to measured adsorbate concentrations and fractional coverage values. Nonlinear regression provides unbiased estimates by avoiding distortions introduced through logarithmic linearization. The resulting parameters describe how adsorption energy decreases with increasing surface coverage. This method is commonly applied in environmental chemistry and materials analysis for systems involving significant adsorbate–adsorbent interactions.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820958"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820959"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820961"/>
        <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820957"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820993"/>
        <schema:description xml:lang="en">nonlinear estimation of Temkin isotherm parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820957 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820957">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">linear parameter estimation (Temkin isotherm model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs linear parameter estimation using adsorption equilibrium data by applying the linearized form of the Temkin isotherm. By plotting fractional coverage against the natural logarithm of solute concentration, the slope and intercept allow direct estimation of the adsorption-energy variation and the Temkin equilibrium constant. Although convenient, the linear method may introduce statistical bias due to transformation of variables. Nevertheless, it is widely used for rapid assessment of Temkin parameters in adsorption analysis. This approach is especially common in environmental and chemical engineering studies of pollutant adsorption.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820958"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820959"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820960"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820993"/>
        <schema:description xml:lang="en">linear estimation of Temkin isotherm parameters</schema:description>
    </owl:NamedIndividual>



