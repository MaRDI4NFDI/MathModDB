    <!-- https://portal.mardi4nfdi.de/entity/Q6822038 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822038">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of crop nitrogen demand</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the daily nitrogen demand of the crop based on accumulated biomass and an optimal nitrogen concentration that depends on development stage. It accounts for nitrogen already taken up in previous days and produces a dynamic demand signal. The result represents the nitrogen requirement needed to sustain optimal growth.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822019"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822021"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822022"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822023"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822032"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822033"/>
        <schema:description xml:lang="en">determine daily nitrogen demand of the crop</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822039 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822039">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of soil nitrogen supply by mass flow</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task estimates the nitrogen supplied to plant roots from each soil layer through mass flow driven by plant water uptake. It combines soil nitrate content, soil water content, and layer-specific plant water use. The task produces a spatially distributed estimate of nitrogen supply from the soil.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821379"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821584"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821596"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822024"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822025"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822034"/>
        <schema:description xml:lang="en">estimating potential nitrogen supply from soil layers</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822040 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822040">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">aggregation of soil nitrogen supply</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task aggregates nitrogen supply across all soil layers to determine the total nitrogen available for uptake by the crop on a given day. The result is used to assess whether soil nitrogen supply is sufficient to meet crop nitrogen demand.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822024"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822027"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822035"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822039"/>
        <schema:description xml:lang="en">compute total nitrogen supply from all soil layers</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822041 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822041">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">adjustment of nitrogen uptake to crop demand</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task adjusts the potential nitrogen supply from each soil layer to ensure consistency with crop nitrogen demand. It enforces upper bounds based on soil nitrate availability and allows compensation when mass flow alone is insufficient. The result represents the actual nitrogen uptake used in crop growth calculations.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822019"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822024"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822027"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822028"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822036"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822037"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822038"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822039"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822040"/>
        <schema:description xml:lang="en">scaling nitrogen uptake to match crop demand</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822042 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822042">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">plant nitrogen uptake and demand model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model simulates crop nitrogen use using a supply–demand framework. Crop nitrogen demand is computed from accumulated biomass and an ideal nitrogen concentration that varies with crop development. Soil nitrogen supply is estimated from nitrate transport to roots by mass flow, distributed across soil layers according to plant water uptake. Actual nitrogen uptake is obtained by adjusting soil nitrogen supply to match crop demand while respecting soil nitrate availability. The model links crop growth, soil water use, and nitrogen dynamics in a mechanistic way.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822038"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822039"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822040"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822041"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821601"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822032"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822033"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822034"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822035"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822037"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">simulation of crop nitrogen demand and soil nitrogen uptake</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822043 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822043">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of crop nitrogen uptake under varying soil conditions</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem concerns the estimation of crop nitrogen uptake as constrained by plant demand and soil nitrogen availability. It addresses how nitrogen demand evolves with crop growth and how soil processes supply nitrogen to roots through water-driven transport. The problem is central to understanding nutrient limitations on crop productivity and nitrogen cycling in agroecosystems.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822042"/>
        <schema:description xml:lang="en">quantify crop nitrogen demand and soil nitrogen supply</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822086 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822086">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
        <mathmoddb:P983 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mi&gt;g&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
