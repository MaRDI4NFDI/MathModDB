        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775654"/>
        <schema:description xml:lang="en">growth of bacterial colonies</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775644 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775644">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Monod equation</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q1944979</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">The Monod model explains how the specific growth rate of microorganisms depends on the availability of a limiting nutrient. It shows that the specific growth rate increases with nutrient concentration but eventually levels off when the microorganisms reach their maximum specific growth rate.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775645"/>
