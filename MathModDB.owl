    <!-- https://portal.mardi4nfdi.de/entity/Q6675379 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6675379">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">poro-visco-elastic model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The elastic stresses are given via the derivative of a free energy density function, the viscous stresses are of Kelvin-Voigt type and formulated in terms of a dissipation potental. The evolution of the concentration is given via a diffusion equation that is pulled-back to the reference configuration. The mobility law depends nonlinearly on the deformation gradient and the concentration itself.</mathmoddb:P1459>
        <mathmoddb:P1459 xml:lang="en">The finite mechanical deformation is quasistatic and is formulated in the Lagrangian frame. The total stress consists of elastic and viscous stresses. Moreover, a second-order hyper-stress regularization is taken into account.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684557"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674247"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674248"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674249"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6577000"/>
        <schema:description xml:lang="en">mathematical model describing the coupled evolution of the mechanical deformation and the concentration of a species</schema:description>
    </owl:NamedIndividual>



