    <!-- https://portal.mardi4nfdi.de/entity/Q6821349 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821349">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Baudu model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to fit the Baudu isotherm model. The objective is to estimate the reference monolayer capacity, reference affinity constant, and the two empirical exponents describing their concentration dependence. The nonlinear fitting approach preserves the intrinsic structure of the Baudu equation and avoids bias introduced by linearization. The resulting parameters quantify surface heterogeneity and explain deviations from constant Langmuir behavior over wide concentration ranges.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821338"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821339"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821340"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821341"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821343"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821344"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821345"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775714"/>
        <schema:description xml:lang="en">nonlinear estimation of Baudu isotherm parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821350 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821350">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Baudu isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Baudu isotherm model is an empirical adsorption model derived from the Langmuir equation by allowing both the adsorption affinity and the monolayer capacity to vary with equilibrium concentration. It was introduced to account for systematic deviations from constant Langmuir parameters observed over wide concentration ranges. By expressing the Langmuir constants as power-law functions of concentration, the model captures surface heterogeneity and concentration-dependent adsorption behavior. At low surface coverage, the Baudu model reduces to the Freundlich isotherm, while retaining a monolayer adsorption structure. The model has been reported to provide improved fits compared with other four-parameter monolayer isotherms in liquid-phase adsorption systems.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821349"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821343"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821344"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821345"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821346"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821347"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775713"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821348"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821374"/>
        <schema:description xml:lang="en">empirical four-parameter monolayer adsorption isotherm</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821351 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821351">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of daylength</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the duration of daylight for a given day and geographic location using latitude and solar declination angle. The task produces a deterministic estimate of photoperiod for each simulation day. The resulting daylength is used to modulate radiation-driven and phenology-dependent biological processes.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6480497"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821287"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821289"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821302"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821303"/>
        <schema:description xml:lang="en">calculates daily daylight duration</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821352 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821352">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">daylength model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model estimates the duration of daylight for a given day and geographic location using astronomical relationships between the Earth and the Sun. Daylength is calculated from latitude and the seasonal variation of the Sun’s declination angle, which arises from Earth’s axial tilt and orbital motion. The model provides a deterministic and time-dependent representation of photoperiod that varies systematically over the year. It does not include biological or atmospheric processes and relies solely on geometric principles. The resulting daylength is used as an environmental forcing variable in crop growth and phenological models.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821351"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821302"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821303"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">astronomical model to estimate the daylength</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821353 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821353">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of astronomical daylength</rdfs:label>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821352"/>
        <schema:description xml:lang="en">determine daily photoperiod from Earth–Sun geometry</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821354 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821354">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of leaf area index dynamics</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the daily evolution of leaf area index throughout the crop growing season. It updates leaf area based on phenological development during the expansion phase and reduces leaf area during senescence. The task incorporates crop-specific limits and stress modulation. The resulting leaf area index is used by radiation interception and other canopy-related processes.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821291"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821293"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821294"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821295"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821296"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821298"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821304"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821306"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821310"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821311"/>
        <schema:description xml:lang="en">simulates daily leaf area index change</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821355 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821355">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">leaf area index model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model simulates the temporal evolution of leaf area index for a crop canopy over the growing season. Leaf area development is driven by phenological progress and constrained by crop-specific maximum values. During early growth stages, the model represents leaf expansion, while during later stages it accounts for leaf senescence and decline. Crop stress factors may reduce the rate of leaf area development relative to potential conditions. The simulated leaf area index is used to control canopy processes such as radiation interception and energy exchange.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821354"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821306"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821310"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821311"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model simulating temporal development of canopy leaf area</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821356 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821356">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">crop canopy development</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem focuses on the development of plant canopy leaf area over the growing season. Leaf area determines light interception, transpiration, and energy exchange between vegetation and the atmosphere. Canopy development depends on phenological progress, growth conditions, and senescence processes. Accurately representing these dynamics is essential for modeling crop growth and ecosystem functioning. The problem links plant structure with physiological and environmental drivers.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821355"/>
        <schema:description xml:lang="en">temporal dynamics of canopy leaf area</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821357 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821357">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of intercepted photosynthetically active radiation</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the amount of photosynthetically active radiation intercepted by a plant canopy. It uses incoming solar radiation and canopy structural properties to estimate the absorbed radiation fraction. The computation assumes a continuous canopy and applies an exponential attenuation formulation. The resulting intercepted radiation serves as an input to biomass production and other radiation-driven processes.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821281"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821282"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821283"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821301"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821304"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821312"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821354"/>
        <schema:description xml:lang="en">calculates canopy-intercepted photosynthetically active radiation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821358 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821358">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">solar radiation interception model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model estimates the fraction of incoming solar radiation that is intercepted by a plant canopy. Interception is computed as a function of incoming radiation and canopy structural properties, particularly leaf area index. The model represents attenuation of radiation within the canopy using an exponential formulation derived from physical light extinction principles. It produces an estimate of photosynthetically active radiation available for photosynthesis. The intercepted radiation serves as a key input to biomass production and other radiation-driven processes.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821357"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821312"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821355"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model estimating canopy-intercepted solar radiation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821359 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821359">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of canopy-intercepted solar radiation</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem concerns the estimation of the portion of incoming solar radiation that is intercepted by a plant canopy. Intercepted radiation determines the energy available for photosynthesis and biomass production. The amount intercepted depends on canopy structure and leaf area distribution. Accurate estimation is essential for modeling plant growth and energy exchange processes. The problem links physical radiation principles with biological canopy properties.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821358"/>
        <schema:description xml:lang="en">quantify radiation intercepted by a plant canopy</schema:description>
    </owl:NamedIndividual>



