    <!-- https://portal.mardi4nfdi.de/entity/Q6820981 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820981">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Flory-Huggins isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Flory–Huggins isotherm is an empirical adsorption model adapted from polymer solution theory that describes how chemically similar molecules of different chain length occupy adsorbent sites. It uses a coverage degree defined from initial and equilibrium concentrations and explicitly accounts for an occupancy number that represents how many adsorbate units occupy a site. The model is used to assess adsorption feasibility and spontaneity via an equilibrium constant that can be related to a standard Gibbs free-energy expression. It is applied when adsorbate molecules are large or chain-like (e.g., polymers, large organics) and the adsorbate–adsorbent arrangement is approximately random.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820982"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820983"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820989"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821374"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820990"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820991"/>
        <schema:description xml:lang="en">adsorption model for multi-site occupancy and chain effects</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820982 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820982">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Flory-Huggins model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task fits the nonlinear Flory–Huggins equation to adsorption data to estimate the Flory–Huggins equilibrium constant and the occupancy number. It uses experimental initial and equilibrium concentrations and measured uptake to directly obtain parameter estimates without data linearization. The outputs quantify the effective site occupancy per adsorbate and the equilibrium parameter used to evaluate spontaneity.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820984"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820985"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820986"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820987"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820989"/>
        <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820983"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820990"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820991"/>
        <schema:description xml:lang="en">nonlinear estimation of Flory–Huggins parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820983 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820983">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">linear parameter estimation (Flory-Huggins model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task uses the linearized Flory–Huggins equation to estimate the equilibrium constant and occupation number from transformed equilibrium data. Linear regression provides a straightforward estimation method, but may introduce bias due to logarithmic transformation. The resulting parameters characterize adsorption feasibility and the extent of surface site occupation in the Flory–Huggins model.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820984"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820985"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820986"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820987"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820988"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820990"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820991"/>
        <schema:description xml:lang="en">linear estimation of Flory–Huggins parameters</schema:description>
    </owl:NamedIndividual>



