        <rdfs:label xml:lang="en">Faraday&apos;s law of induction</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Faraday%27s_law_of_induction"/>
        <mathmoddb:P12 xml:lang="en">Q181465</mathmoddb:P12>
