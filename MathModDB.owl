    <!-- https://portal.mardi4nfdi.de/entity/Q6775665 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775665">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">kinetic batch reactor model (Monod)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Monod-based kinetic batch reactor model is a mathematical model that describes the growth of microorganisms and substrate consumption in a closed system. It relates the rate of biomass change to the concentration of a limiting substrate and includes a death rate coefficient to account for microbial decay.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775666"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775681"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775678"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775763"/>
        <schema:description xml:lang="en">mathematical model for biomass growth and substrate utilization in a batch reactor following Monod</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775666 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775666">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">evaluation of biokinetic parameters</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental data for biomass concentration and substrate concentration in a bioreactor. The objective is to determine key kinetic parameters, including the maximum specific growth rate, Monod constant, and death rate coefficient, by fitting a dynamic model of biomass growth and substrate consumption to the observed data.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673927"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775647"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775648"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775669"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775670"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775681"/>
        <schema:description xml:lang="en">kinetic batch reactor model following Monod</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775667 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775667">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">kinetic batch reactor model (Haldane)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Haldane-based kinetic batch reactor model is a mathematical model that describes the growth of microorganisms and substrate consumption in a closed system. It relates the rate of biomass change to the concentration of a limiting substrate, includes a death rate coefficient to account for microbial decay, and a substrate inhibition constant to account for substrate inhibition at high concentrations.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775668"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775682"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775665"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775678"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q1437088"/>
        <schema:description xml:lang="en">mathematical model for biomass growth and substrate utilization in a batch reactor following Haldane</schema:description>
    </owl:NamedIndividual>



