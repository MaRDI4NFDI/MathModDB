        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821193"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821197"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821198"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821199"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821200"/>
        <schema:description xml:lang="en">estimation of Fritz-Schlunder model parameters</schema:description>
    </owl:NamedIndividual>



