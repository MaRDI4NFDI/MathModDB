    <!-- https://portal.mardi4nfdi.de/entity/Q6820962 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820962">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Fowler-Guggenheim isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Fowler–Guggenheim isotherm model is an adsorption model that incorporates lateral interactions between adsorbed molecules. Unlike Langmuir’s assumption of independent adsorption sites, this model allows the heat of adsorption to vary with surface coverage. Attractive interactions raise adsorption energy with increasing coverage, while repulsive interactions cause the opposite trend. The model provides a more realistic description for adsorbates that influence each other after adsorption. It is commonly applied in surface chemistry and environmental adsorption analysis, including chemical wastewater treatment.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820963"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820964"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820968"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q2595344"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q561111"/>
        <schema:description xml:lang="en">mathematical model for adsorption with lateral interactions</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820963 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820963">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Fowler-Guggenheim isotherm model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Fowler–Guggenheim equilibrium constant and the interaction energy. The nonlinear Fowler–Guggenheim equation is fitted directly to fractional coverage and concentration data, capturing the effect of lateral interactions among adsorbed molecules. The results quantify both adsorption affinity and the magnitude of intermolecular interactions. This provides an accurate description of systems where adsorption behavior depends on the occupancy of neighboring sites.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820965"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820966"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820968"/>
        <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820964"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q2595344"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q561111"/>
        <schema:description xml:lang="en">nonlinear estimation of Fowler–Guggenheim parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6820964 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6820964">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">linear parameter estimation (Fowler-Guggenheim isotherm model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task estimates the Fowler–Guggenheim equilibrium constant and the interaction energy using the linearized form of the isotherm. Experimental equilibrium data are transformed and fitted using linear regression, providing a simplified estimation method. While computationally efficient, this approach may introduce bias from linearization. The results characterize the adsorption affinity and the sign and magnitude of lateral adsorption interactions.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820965"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820966"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820967"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q2595344"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q561111"/>
        <schema:description xml:lang="en">linear estimation of Fowler–Guggenheim parameters</schema:description>
    </owl:NamedIndividual>



