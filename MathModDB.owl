    <!-- https://portal.mardi4nfdi.de/entity/Q6821387 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821387">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of root biomass allocation</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the fraction of daily crop biomass growth that is allocated to the root system. The allocation fraction is determined as a linear function of phenological development. The task produces a deterministic estimate of daily root biomass increment, which is used to update root system mass.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821284"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821314"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821377"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821383"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821420"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821425"/>
        <schema:description xml:lang="en">allocates daily biomass growth to the root system</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821388 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821388">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of rooting depth</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes crop rooting depth as a function of phenological development and crop-specific root characteristics. Rooting depth increases with accumulated heat units and is capped by the potential root zone depth of the soil. The task produces a deterministic estimate of rooting depth at each time step. The resulting depth constrains root biomass distribution and soil water and nutrient uptake processes.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821380"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821381"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821382"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821385"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821386"/>
        <schema:description xml:lang="en">calculates crop rooting depth from phenological development</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821389 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821389">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of root biomass distribution</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes how daily root biomass growth is distributed across the soil profile. It allocates the total root biomass increment to individual soil layers based on their relative contribution to plant water uptake. The task produces a layer-specific root biomass increment for each time step. The resulting distribution is used to represent root presence and function within the soil.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821377"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821378"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821379"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821384"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821387"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821596"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824222"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824223"/>
        <schema:description xml:lang="en">allocates daily root growth to soil layers</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821390 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821390">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">root biomass partitioning model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model computes the potential daily increase in crop root biomass by allocating a fraction of total biomass growth to the root system. The allocation fraction decreases linearly with phenological development, reflecting a shift in carbon partitioning from roots to aboveground organs as the crop matures. At emergence, a larger share of biomass is allocated to roots, while at maturity this share is reduced. The model represents empirical knowledge of crop biomass partitioning in a simplified and deterministic manner. The resulting root biomass increment serves as input for root distribution and soil interaction models.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821387"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821315"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821383"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model allocating biomass growth to the root system</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821391 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821391">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">root depth model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model simulates the temporal development of crop rooting depth during the growing season. Root depth increases as a function of phenological development and approaches a crop-specific maximum under ideal soil conditions. The model assumes that rooting depth expands rapidly early in the growing season and reaches its maximum well before physiological maturity. Root depth is constrained by the depth of the soil profile, preventing unrealistic penetration beyond available soil layers. The simulated rooting depth limits the spatial extent of root biomass distribution and soil resource uptake.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821388"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821385"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821386"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model simulating crop rooting depth development</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821392 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821392">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of root biomass partitioning</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem addresses the estimation of how total crop biomass growth is partitioned between aboveground and belowground components. Biomass allocation to roots varies systematically over the growing season and influences soil resource uptake. Representing this allocation is essential for modeling crop growth and plant–soil interactions. The problem focuses on capturing empirically observed shifts in partitioning as crops develop from emergence to maturity.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821390"/>
        <schema:description xml:lang="en">quantify allocation of crop biomass to roots</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821393 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821393">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">root biomass distribution model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model simulates the vertical distribution of root biomass growth within the soil profile. Newly formed root biomass is allocated among soil layers in proportion to plant water use in each layer. This approach links root development to functional root activity rather than purely geometric depth. Under non-limiting conditions, the formulation produces an exponential decrease in root biomass with depth. When soil water availability or root stress factors constrain growth, both water use and root biomass allocation are reduced accordingly.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821389"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821384"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821390"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824223"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model distributing root biomass growth across soil layers</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821394 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821394">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of crop rooting depth</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem addresses the estimation of how deep crop roots extend into the soil over time. Rooting depth determines access to water and nutrients stored in deeper soil layers and influences crop resilience to drought. In many crops, rooting depth increases rapidly early in development and reaches its maximum before maturity. Accurate representation of rooting depth is essential for modeling soilplant interactions and belowground resource availability. The problem links phenological development with physical constraints imposed by soil depth.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821391"/>
        <schema:description xml:lang="en">quantify the vertical extent of the crop root system</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821395 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821395">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of vertical root biomass distribution</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem concerns the representation of how crop root biomass is distributed vertically within the soil profile. Root distribution determines which soil layers contribute to water and nutrient uptake. A realistic description must account for functional root activity rather than only geometric depth. The problem focuses on linking root growth allocation to soil-layer-specific conditions, such as water availability. Accurate representation of vertical root distribution is essential for modeling soil-plant interactions and crop responses to environmental stress.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821393"/>
        <schema:description xml:lang="en">quantify how root growth is distributed across soil layers</schema:description>
    </owl:NamedIndividual>



