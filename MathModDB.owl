        <rdfs:label xml:lang="en">optimal plant phosphorus concentration equation</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Defines the optimal phosphorus concentration of plant biomass as a decreasing exponential function of crop phenological development represented by the heat unit index.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">estimates ideal crop phosphorus concentration as function of development</schema:description>
    </owl:NamedIndividual>
