    <!-- https://portal.mardi4nfdi.de/entity/Q6684617 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6684617">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">semiconductor thermodynamic equilibrium</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Defines semiconductor thermodynamic equilibrium as the solution of the nonlinear Poisson equation. The resulting electrostatic potential is the built-in potential, for which drift and diffusion currents exactly balance each other, yielding zero net current.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673929"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q7284038"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q7284044"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q7284045"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q7284046"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534341"/>
        <schema:description xml:lang="en">thermodynamic equilibrium in semiconductors corresponding to zero net current defined by nonlinear Poisson equation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6684618 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6684618">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">semiconductor current voltage</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">In simulations of semiconductor devices, one is usually interested in IV-curves displaying the current voltage charateristics, i.e., the dependence of terminal currents on applied voltages. Therefore, calculating terminal currents accurately is crucial to a successful postprocessing of the simulated ﬁeld data.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673740"/>
        <schema:description xml:lang="en">calculating IV-curves displaying the current voltage charateristics of a semiconductor device</schema:description>
    </owl:NamedIndividual>



