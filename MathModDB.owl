    <!-- https://portal.mardi4nfdi.de/entity/Q6830614 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6830614">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">Taylor–Couette flow</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Taylor%E2%80%93Couette_flow"/>
        <mathmoddb:P12 xml:lang="en">Q3151656</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">The stationary flow of an incompressible fluid confined in between two rotating cylinders of different radii and angular velocities is a well-known benchmark problem in numerical fluid dynamics. For low relative angular velocities and for a small gap (relative to the diameters of the cylinders), i.e., for a Reynolds number, the flow is steady and purely azimuthal, for which case an analytical solution exists.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1463 rdf:resource="https://portal.mardi4nfdi.de/entity/Q16496"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6830616"/>
        <mathmoddb:P1690 rdf:resource="https://www.openfoam.com/documentation/guides/v1912/doc/guide-applications-solvers-incompressible-simpleFoam.html"/>
        <mathmoddb:P1690 rdf:resource="https://www.openfoam.com/documentation/guides/v1912/doc/verification-validation-rotating-cylinders-2d.html"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6830687"/>
        <mathmoddb:P356 rdf:resource="http://commons.wikimedia.org/wiki/Special:FilePath/CouetteTaylorSystem.png"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q1512328"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q564419"/>
        <schema:description xml:lang="en">viscous fluid confined in the gap between two rotating cylinders of different radii and angular velocities</schema:description>
    </owl:NamedIndividual>



