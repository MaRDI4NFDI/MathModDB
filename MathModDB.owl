        <rdfs:label xml:lang="en">interaction force on an individual</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The interaction force on individual i is given by a weighted sum of attractive forces from all other connected individuals j, the respective media and the respective influencer scaled by the parameters a,b,c &gt; 0 respectively.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    </owl:NamedIndividual>
