        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">effective conductivity</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Effective conductivity refers to the combined effects of conduction, convection, and radiation heat transfer within an enclosed space or material and measures how effectively the medium can transfer heat.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">combined effects of conduction, convection, and radiation heat transfer within an enclosed space or material</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6673939 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6673939">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534245"/>
        <rdfs:label xml:lang="en">effective mass</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Effective_mass"/>
        <mathmoddb:P12 xml:lang="en">Q1064434</mathmoddb:P12>
        <mathmoddb:P1212 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mi&gt;𝖬&lt;/mi&gt;&lt;/mrow&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P1212>
        <mathmoddb:P1459 xml:lang="en">The mass that a particle appears to have when responding to forces, or the mass that it seems to have when interacting with other identical particles.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1654 xml:lang="en">EffectiveMass</mathmoddb:P1654>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673940"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673941"/>
        <schema:description xml:lang="en">mass that a particle appears to have when responding to forces</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6673940 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6673940">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">effective mass (solid-state physics)</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Effective_mass_(solid-state_physics)"/>
        <mathmoddb:P1459 xml:lang="en">In solid state physics, effective electron masses are deduced from band structure calculations (curvature of bands). In certain cases, these masses can have negative values. Their absolute values are typically found between 0.01 and 10 times the mass of a free electron.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q1064434"/>
        <schema:description xml:lang="en">effective electron masses are deduced from band structure calculations (curvature of bands)</schema:description>
    </owl:NamedIndividual>



