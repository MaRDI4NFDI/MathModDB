    <!-- https://portal.mardi4nfdi.de/entity/Q6821427 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821427">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of harvest index heat unit factor</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes a phenological scaling factor that governs the rate of harvest index development. The factor is derived from the heat unit index using a non-linear response function that reflects observed patterns of reproductive development in crops. It ensures that harvest index increases slowly during early growth and more rapidly during later stages of development. The task provides the daily heat unit factor used as input to the harvest index development computation. It links phenological progress to above ground biomass allocation to crop yield.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821417"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821423"/>
        <schema:description xml:lang="en">calculates heat unit factor affecting harvest index</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821428 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821428">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of above-ground biomass</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the total above-ground biomass from the accumulated potential biomass and the accumulated potential root weight.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821299"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821314"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821387"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821419"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821420"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821426"/>
        <schema:description xml:lang="en">calculates above-ground biomass</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821429 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821429">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of harvest index development</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the temporal development of harvest index over the growing season. It integrates the daily heat unit-based harvest index factor to represent the progressive allocation of above ground biomass to crop yield. The task produces the harvest index value for each time step, starting from zero at planting and approaching a crop-specific maximum at maturity. It depends on the computation of the harvest index heat unit factor, which controls the rate and timing of development. The resulting harvest index is used to track the progression of reproductive development and to determine when the crop has reached its final harvest index value.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821414"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821415"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821416"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821422"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821427"/>
        <schema:description xml:lang="en">calculates harvest index over time</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821430 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821430">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of crop economic yield</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes crop economic yield by multiplying above-ground biomass by harvest index. It produces a final yield estimate at maturity. The task assumes non-stressed conditions unless modified by additional stress models.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821415"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821418"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821419"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821424"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821428"/>
        <schema:description xml:lang="en">calculates harvestable crop yield</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821431 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821431">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">harvest index development model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model simulates the development of harvest index over the growing season. Harvest index represents the fraction of above-ground biomass allocated to crop yield. The model assumes that harvest index increases non-linearly from planting to maturity under non-stressed conditions. Development is controlled by phenological progress using a heat unit based scaling factor. The simulated harvest index is used to compute final crop yield.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821427"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821429"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821422"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821423"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model simulating temporal development of harvest index</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821432 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821432">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">economic yield model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model computes crop economic yield using the harvest index concept. Economic yield is calculated as the product of harvest index and above-ground biomass at maturity. The formulation assumes that yield is proportional to accumulated vegetative production. The model provides a simplified but robust estimate of harvestable crop yield. It does not explicitly represent grain filling or reproductive organ growth.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821428"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821430"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821315"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821424"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821426"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">model computing crop economic yield from above-ground biomass</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821433 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821433">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of harvest index development</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem addresses how crops allocate above-ground biomass to reproductive or economic organs over time. Harvest index is often relatively stable at maturity but develops dynamically during the growing season. Accurately representing its development is essential for predicting crop yield. The problem links phenological development with above-ground biomass partitioning to reproductive structures.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821431"/>
        <schema:description xml:lang="en">quantify temporal allocation of above-ground biomass to crop yield</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821434 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821434">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
        <rdfs:label xml:lang="en">estimation of crop economic yield</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This research problem concerns the estimation of harvestable crop yield based on biomass production. Economic yield represents the portion of plant biomass that can be removed from the field. Accurate yield estimation is central to agricultural and food system modeling. The problem links biomass accumulation with reproductive allocation.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821432"/>
        <schema:description xml:lang="en">quantify harvestable yield from above-ground crop biomass</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821435 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821435">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
        <rdfs:label xml:lang="en">agronomy</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q173113</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">Agronomy is the science and technology of producing and using plants for food, fuel, fiber, and land management. A central concern of the discipline is the estimation and improvement of crop yield under field conditions. Agronomic models translate plant growth processes into practical measures of agricultural productivity. Harvest index–based approaches provide a widely used method to link biomass production with economically relevant yield.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821434"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822043"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822115"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824238"/>
        <schema:description xml:lang="en">science and technology of producing and using plants for food, fuel, fiber, and reclamation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821436 -->


