        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534337"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q7253780"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q7253901"/>
        <mathmoddb:P1640 rdf:resource="https://portal.mardi4nfdi.de/wiki/File:3082a.jpg"/>
