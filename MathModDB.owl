        <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Quantum_state"/>
        <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q190524"/>
        <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q230883"/>
        <schema:description xml:lang="en">quantized energy levels that a quantum system can possess</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6534308 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6534308">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">quantum state vector (stationary)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Abstract (Dirac) notation as stationary quantum states or wave functions in coordinate representation.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775395"/>
        <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Quantum_state"/>
        <schema:description xml:lang="en">solutions of the time-independent Schrödinger equation, giving stationary states of a (closed) quantum system</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6534309 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6534309">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">quantum number</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Quantum_number"/>
        <mathmoddb:P12 xml:lang="en">Q232431</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">In quantum physics and chemistry, quantum numbers are quantities that characterize the possible states of the system. Quantum numbers are closely related to eigenvalues of observables. When the corresponding observable commutes with the Hamiltonian, the quantum number is said to be &quot;good&quot;, and acts as a constant of motion in the quantum dynamics.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">quantities that characterize the possible states of the system</schema:description>
    </owl:NamedIndividual>



