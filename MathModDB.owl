    <!-- https://portal.mardi4nfdi.de/entity/Q6674544 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6674544">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
        <rdfs:label xml:lang="en">periodic boundary conditions</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Periodic_boundary_conditions"/>
        <mathmoddb:P12 xml:lang="en">Q2992284</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">When an object passes through one side of the unit cell, it re-appears on the opposite side with the same velocity. In topological terms, the space made by one-dimensional PBCs can be thought of as being mapped onto a circle. The space made by two-dimensional PBCs can be thought of as being mapped onto a torus.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534337"/>
        <schema:description xml:lang="en">set of boundary conditions which are often chosen for approximating a large (infinite) system by using a small part called a unit cell</schema:description>
    </owl:NamedIndividual>



