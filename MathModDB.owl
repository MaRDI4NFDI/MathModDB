    <!-- https://portal.mardi4nfdi.de/entity/Q6824235 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6824235">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of crop phosphorus demand</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task estimates the daily phosphorus demand of a crop based on accumulated plant biomass and an optimal phosphorus concentration that declines with phenological development. The optimal concentration is computed as a nonlinear function of heat unit index, and cumulative phosphorus uptake is subtracted to determine unmet demand.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822021"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824224"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824226"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824227"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824231"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824232"/>
        <schema:description xml:lang="en">determine daily phosphorus demand of the crop</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6824236 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6824236">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of soil phosphorus supply</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task estimates the phosphorus supply available to the crop from the soil based on plant phosphorus demand, root biomass distribution across soil layers, and labile phosphorus availability. A nonlinear labile phosphorus uptake factor modulates root-weighted supply, allowing enhanced uptake under phosphorus-deficient conditions.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
