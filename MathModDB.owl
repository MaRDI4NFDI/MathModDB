    <!-- https://portal.mardi4nfdi.de/entity/Q6821222 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821222">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Koble-Corrigan model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task involves nonlinear regression of equilibrium adsorption data to estimate the parameters of the Koble-Corrigan isotherm model. Experimental measurements of equilibrium adsorbed amount and solute concentration are fitted to the model equation. The fitting procedure determines the constants, which control adsorption capacity and saturation behavior, as well as the heterogeneity exponent. The task is commonly used when adsorption occurs on heterogeneous surfaces and cannot be adequately described by simpler Langmuir or Freundlich models alone.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821215"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821216"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821217"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821218"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821221"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775714"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775722"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775767"/>
        <schema:description xml:lang="en">nonlinear estimation of hybrid isotherm parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821223 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821223">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Koble-Corrigan isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Koble-Corrigan isotherm model is an empirical adsorption model that combines features of the Langmuir and Freundlich isotherms. It is designed to describe equilibrium adsorption on heterogeneous surfaces over a wide concentration range. The model introduces an exponent to capture surface heterogeneity while retaining a saturation behavior at high concentrations. Unlike ideal monolayer models, it does not assume uniform adsorption energies. The Koble-Corrigan model is frequently applied when simpler two-parameter models fail to adequately fit experimental adsorption data.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821222"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821218"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821221"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775713"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775721"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821220"/>
        <schema:description xml:lang="en">three-parameter hybrid adsorption isotherm</schema:description>
    </owl:NamedIndividual>



