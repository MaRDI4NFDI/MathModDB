        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821613"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822055"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822201"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822202"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q74562"/>
        <schema:description xml:lang="en">equation that relates the coverage or adsorption of molecules on a solid surface to gas pressure or concentration of a medium above the solid surface at a fixed temperature in equilibrium</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775767 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775767">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Langmuir adsorption model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Langmuir adsorption constant and maximum monolayer adsorption capacity by fitting the nonlinear Langmuir equation directly to measured solute concentration and adsorbed amount data. The results quantify the adsorption affinity and monolayer capacity of the adsorbent without bias from linearization.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
