        <rdfs:label xml:lang="en">attraction dominates repulsion assumption</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">At close distances the attractive force diminishes due to the presence of the repulsive force.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">attractive forces always dominate repulsive forces</schema:description>
    </owl:NamedIndividual>
