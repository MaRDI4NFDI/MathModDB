    <!-- https://portal.mardi4nfdi.de/entity/Q6821333 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821333">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Frumkin model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Frumkin equilibrium constant and the lateral interaction parameter by fitting the nonlinear Frumkin isotherm equation to measured solute concentration and fractional surface coverage data. The task captures deviations from ideal Langmuir behavior arising from attractive or repulsive interactions among adsorbed molecules. Nonlinear fitting preserves the thermodynamic structure of the model and avoids distortions introduced by linearization. The resulting parameters characterize both adsorption affinity and interaction effects on the adsorbent surface.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821329"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821330"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821331"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775767"/>
        <schema:description xml:lang="en">nonlinear estimation of Frumkin isotherm parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821334 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821334">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">Frumkin isotherm model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The Frumkin isotherm model is an adsorption model that extends the Langmuir framework by explicitly accounting for lateral interactions between adsorbed molecules. It assumes monolayer adsorption on a surface with energetically equivalent sites while allowing attractive or repulsive interactions among neighboring adsorbates. The strength and sign of these interactions influence the shape of the adsorption isotherm and the variation of adsorption energy with surface coverage. In the absence of lateral interactions, the Frumkin model reduces to the Langmuir isotherm. The model is closely related to the Fowler–Guggenheim isotherm and is widely applied in solution-phase adsorption studies, including chemical wastewater treatment.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821333"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821331"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821332"/>
        <schema:description xml:lang="en">adsorption isotherm with lateral adsorbate interactions</schema:description>
    </owl:NamedIndividual>



