    <!-- https://portal.mardi4nfdi.de/entity/Q6821314 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821314">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of potential crop biomass growth</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the potential accumulation of crop biomass based on intercepted photosynthetically active radiation and phenological development. It represents the upper bound of biomass growth achievable under optimal radiation conditions, prior to the application of biomass-reducing stresses such as water or nutrient limitation. The task integrates astronomical calculations, phenological scaling, and canopy development to determine daily potential biomass increments. Leaf area development is influenced by crop stress, but biomass conversion itself follows a radiation use efficiency approach. The resulting potential biomass provides the basis for subsequent structural development and yield formation tasks.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821281"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821284"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821285"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821286"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821299"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821307"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821313"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821351"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821357"/>
        <schema:description xml:lang="en">calculating stress-free crop biomass accumulation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6821315 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821315">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">potential crop growth model (biomass)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This model determines crop biomass production assuming no limitations from water, nutrients, pests, or diseases. Growth is driven by intercepted solar radiation and a crop-specific radiation use efficiency parameter. The model represents the maximum achievable growth rate under prevailing weather conditions. Phenological development controls the timing and partitioning of growth but does not constrain resource availability. The resulting biomass represents potential growth against which stress effects are later applied.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821314"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821307"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821313"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821352"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821358"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
        <schema:description xml:lang="en">radiation-driven crop biomass production under optimal conditions</schema:description>
    </owl:NamedIndividual>



