    <!-- https://portal.mardi4nfdi.de/entity/Q6821060 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821060">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Jovanovic multilayer model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using equilibrium adsorption data. The objective is to determine the Jovanovic monolayer capacity together with the first-layer and multilayer adsorption constants by directly fitting the nonlinear multilayer Jovanovic equation to measurements of solute concentration and adsorbed amount. Unlike linearized approaches, nonlinear fitting preserves the intrinsic exponential structure of the multilayer model.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
