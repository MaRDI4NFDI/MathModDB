        <mathmoddb:P1674 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674256"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674260"/>
        <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Hamiltonian_mechanics"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6481547"/>
        <schema:description xml:lang="en">classical equations of motion for systems described by a Hamiltonian function specifying the total energy</schema:description>
    </owl:NamedIndividual>
