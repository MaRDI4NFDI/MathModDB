    <!-- https://portal.mardi4nfdi.de/entity/Q6675440 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6675440">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">numerical model of the solar system</rdfs:label>
        <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Numerical_model_of_the_Solar_System"/>
        <mathmoddb:P12 xml:lang="en">Q7069658</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">Neglecting dwarf planets, satellites (e.g. Moon), asteroids, as well as the interaction with other stars or exoplanets. The numerical model of the Solar System consists of a set of mathematical equations, which, when solved, give the approximate positions of the planets as a function of time.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674575"/>
        <schema:description xml:lang="en">classical mechanics model of the sun (fixed) and the 8 planets (moving) as point masses</schema:description>
    </owl:NamedIndividual>



