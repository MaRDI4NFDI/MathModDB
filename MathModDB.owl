        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824233"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824234"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824235"/>
        <schema:description xml:lang="en">root-weighted phosphorus supply estimation</schema:description>
