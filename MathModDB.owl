        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">accumulated root weight in soil layer</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This quantity represents the accumulated root weight allocated to a specific soil layer up to a specific day. It is a portion of the accumulated total root weight.</mathmoddb:P1459>
