        <rdfs:label xml:lang="en">vibrational frequency shift (1st order)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">The interpretation is quite straight-forward: Effectively, the intermolecular potential changes the effective force constant of a vibrational normal mode.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">frequency shift of molecular vibrations caused by interaction with surrounding particles  from 1st order non-degenerate perturbation theory</schema:description>
    </owl:NamedIndividual>
