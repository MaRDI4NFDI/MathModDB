        <mathmoddb:P983 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mi&gt;h&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
        <mathmoddb:P983 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
