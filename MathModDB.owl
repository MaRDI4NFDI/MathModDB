    <!-- https://portal.mardi4nfdi.de/entity/Q6775845 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775845">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Hill binding model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation for the Hill binding model using equilibrium ligand-binding data. It determines the Hill binding constant, maximal occupancy, and the cooperativity exponent by fitting the nonlinear Hill binding equation directly to free-ligand concentrations and fractional binding measurements. Nonlinear regression avoids artifacts from linearization and produces accurate estimates across cooperative, non-cooperative, and anti-cooperative regimes. The resulting parameters quantify binding affinity, saturation behavior, and the degree of cooperative interaction among binding sites. This method is commonly applied in biochemistry, molecular biology, and systems biology to study cooperative ligand–macromolecule interactions.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775844"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775846"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775849"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775855"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775857"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3116516"/>
        <schema:description xml:lang="en">nonlinear estimation of Hill binding model parameters</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775846 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775846">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
        <rdfs:label xml:lang="en">Hill coefficient</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q1618639</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">The Hill cooperativity coefficient is a dimensionless empirical parameter that quantifies the degree of cooperative behavior in a system modeled by a Hill-type equation. It determines how strongly the binding, adsorption, catalytic rate, or biological response departs from simple non-cooperative behavior. Values greater than one represent positive cooperativity, where one binding or adsorption event increases the likelihood of additional events, while values less than one indicate negative cooperativity. A value of exactly one corresponds to non-cooperative, hyperbolic behavior as seen in classical Langmuir, Michaelis–Menten, or Emax models. The Hill coefficient does not reflect a mechanistic number of sites but rather describes the steepness of the sigmoidal response curve.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3116516"/>
        <schema:description xml:lang="en">slope of the curve describing the binding of an inhibitor or a substrate</schema:description>
    </owl:NamedIndividual>



