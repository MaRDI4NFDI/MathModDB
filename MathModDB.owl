        <rdfs:label xml:lang="en">change in opinions of media</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Media agents m = 1,...,M slowly adapt their opinions according to this stochastic differential equation such that media agents are drawn in the direction of the average opinion of their followers.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <schema:description xml:lang="en">opinion adaption of media agents over time</schema:description>
    </owl:NamedIndividual>
