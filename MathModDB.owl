    <!-- https://portal.mardi4nfdi.de/entity/Q6674354 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6674354">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
        <mathmoddb:P983 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mi&gt;F&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
        <mathmoddb:P983 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mi&gt;ρ&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
        <mathmoddb:P989 xml:lang="en">&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot; class=&quot;mwe-math-element mwe-math-element-inline&quot;&gt;&lt;mrow data-mjx-texclass=&quot;ORD&quot;&gt;&lt;mstyle displaystyle=&quot;true&quot; scriptlevel=&quot;0&quot;&gt;&lt;mi&gt;F&lt;/mi&gt;&lt;mo stretchy=&quot;false&quot;&gt;∝&lt;/mo&gt;&lt;mi mathvariant=&quot;normal&quot;&gt;∇&lt;/mi&gt;&lt;mi&gt;ρ&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
        <rdfs:label xml:lang="en">transport equation</rdfs:label>
        <mathmoddb:P12 xml:lang="en">Q105560509</mathmoddb:P12>
        <mathmoddb:P1459 xml:lang="en">There are several (constitutive) equations which describe the transport of matter, or properties of it, in an almost identical way. In every case, in words they read: Flux (density) is proportional to a gradient, where the constant of proportionality is a characteristic of the material. In general, the constant must be replaced by a 2nd rank tensor, to account for directional dependencies of the material.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674255"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674304"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674310"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674324"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674358"/>
        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775445"/>
        <mathmoddb:P1691 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674283"/>
        <schema:description xml:lang="en">equation that describes the transport of some (extensive) quantity such as mass, energy|heat, momentum, electric charge</schema:description>
    </owl:NamedIndividual>
