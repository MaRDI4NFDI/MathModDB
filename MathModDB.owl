    <!-- https://portal.mardi4nfdi.de/entity/Q6822109 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822109">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of fixation growth stage factor</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the growth stage limitation factor for biological nitrogen fixation in legume crops based on phenological development. The factor represents the availability and activity of functional root nodules and suppresses nitrogen fixation during early growth before nodulation and during late growth when nodules senesce. Phenological development is represented by the heat unit index, and the factor is defined using a piecewise linear function that activates fixation only during an intermediate portion of the growing season.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822098"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822106"/>
        <schema:description xml:lang="en">phenological limitation of nitrogen fixation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822110 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822110">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of fixation soil water factor</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes a dimensionless soil water factor that limits biological nitrogen fixation in legume crops based on near-surface soil moisture conditions. The factor represents the reduction of nitrogen fixation when soil water content in the upper soil layer falls below a threshold fraction of field capacity. When soil moisture is adequate, nitrogen fixation proceeds without water limitation; under drier conditions, fixation is progressively reduced. The formulation captures the sensitivity of symbiotic nitrogen fixation to soil water stress and links soil hydrological status to plant nitrogen acquisition.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822096"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822099"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822100"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822101"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822107"/>
        <schema:description xml:lang="en">soil moisture limitation of nitrogen fixation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822111 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822111">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of fixation soil nitrate factor</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes a soil nitrate limitation factor that reduces or suppresses biological nitrogen fixation based on the amount of nitrate available in the root zone. Low nitrate availability allows full fixation, moderate nitrate levels progressively inhibit fixation, and high nitrate availability completely suppresses fixation. The formulation reflects plant regulation of symbiotic nitrogen fixation in response to readily available mineral nitrogen in the soil.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821380"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821388"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822097"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822102"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822108"/>
        <schema:description xml:lang="en">nitrate inhibition of nitrogen fixation</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822112 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822112">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of nitrogen fixation fraction</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the daily fraction of plant nitrogen demand that can be met through biological nitrogen fixation in legume crops. The fixation fraction integrates multiple limiting factors, including crop phenological development, soil water availability, and soil nitrate content in the root zone. Growth-stage control accounts for nodule development and senescence using heat-unit-based thresholds, while soil water and nitrate factors reduce or suppress fixation under unfavorable conditions. The final fixation fraction is determined by combining these factors using minimum and multiplicative operators, ensuring biologically realistic regulation of symbiotic nitrogen fixation.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822095"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822096"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822097"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822098"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822105"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822109"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822110"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822111"/>
        <schema:description xml:lang="en">determine fraction of nitrogen demand fixed</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822113 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822113">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">computation of daily nitrogen fixation</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task computes the daily amount of biologically fixed nitrogen in legume crops as a fraction of plant nitrogen demand. The fixation rate is regulated by crop development stage, soil water availability, and soil nitrate content. The task represents symbiotic nitrogen fixation through root nodules and limits fixation when environmental or physiological conditions are unfavorable.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822019"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822038"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822094"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822095"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822103"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822104"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822112"/>
        <schema:description xml:lang="en">determine daily biologically fixed nitrogen</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6822114 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6822114">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
        <rdfs:label xml:lang="en">plant nitrogen fixation model</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">Deterministic model estimating daily biological nitrogen fixation as a function of plant nitrogen demand, phenological development, soil water availability, and soil nitrate concentration. Nitrogen fixation is constrained by growth stage, soil moisture in the upper soil profile, and nitrate availability in the root zone. The model operates at daily time steps and integrates physiological and soil constraints relevant to legume crops.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822109"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822110"/>
        <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822111"/>
