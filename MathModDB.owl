        <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
        <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821181"/>
        <schema:description xml:lang="en">empirical isotherm model for low adsorbate concentrations</schema:description>
    </owl:NamedIndividual>



