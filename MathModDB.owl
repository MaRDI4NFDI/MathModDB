    <!-- https://portal.mardi4nfdi.de/entity/Q6821194 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6821194">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">nonlinear parameter estimation (Fritz-Schlunder 5-parameter model)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task concerns fitting the five parameters of the FritzSchlunder 5-parameter isotherm to experimental adsorption data. The model’s high flexibility allows it to capture complex adsorption behavior but requires robust nonlinear optimization to avoid parameter correlation. The estimation involves adjusting the saturation capacity, two constants, and two exponents simultaneously. It is used when adsorption systems exhibit unusual heterogeneity or curvature not representable by simpler models. Accurate parameters enable detailed empirical characterization of challenging adsorption systems.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
