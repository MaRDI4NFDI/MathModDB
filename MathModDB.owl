        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q74555"/>
        <schema:description xml:lang="en">mathematical model for equilibrium adsorption of solutes on heterogeneous surfaces</schema:description>
    </owl:NamedIndividual>



    <!-- https://portal.mardi4nfdi.de/entity/Q6775714 -->


    <owl:NamedIndividual rdf:about="https://portal.mardi4nfdi.de/entity/Q6775714">
        <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
        <rdfs:label xml:lang="en">linear parameter estimation (Freundlich isotherm)</rdfs:label>
        <mathmoddb:P1459 xml:lang="en">This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Freundlich capacity and adsorption intensity constants by fitting the linearized Freundlich equation to measured solute concentration and adsorbed amount data. The results characterize the adsorption capacity and surface heterogeneity of the adsorbent.</mathmoddb:P1459>
        <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
        <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775717"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775718"/>
        <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775719"/>
        <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q74555"/>
        <schema:description xml:lang="en">determine Freundlich capacity and intensity from experimental data</schema:description>
    </owl:NamedIndividual>



